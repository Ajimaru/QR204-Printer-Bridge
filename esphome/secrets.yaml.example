# Copy this file to "secrets.yaml" next to thermal-printer.yaml and replace every value.
# secrets.yaml is git-ignored: never commit it.

# WiFi the bridge joins. The password is also used for the fallback access point
# "thermal-printer", so it must be at least 8 characters.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# Key for the encrypted Home Assistant API (also protects OTA updates). Generate one with:
#   openssl rand -base64 32
api_encryption_key: "REPLACE-WITH-OUTPUT-OF-openssl-rand-base64-32"

# Login for the bridge's web UI (http://thermal-printer.local/)
web_server_username: "admin"
web_server_password: "choose-a-password"
